{
  "name": "propresenter-js",
  "version": "1.3.0",
  "description": "A JavaScript/TypeScript library for working with ProPresenter data.",
  "license": "MIT",
  "author": "magical <sun920122@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/sun92122/propresenter-js.git"
  },
  "homepage": "https://github.com/sun92122/propresenter-js#readme",
  "bugs": {
    "url": "https://github.com/sun92122/propresenter-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "propresenter",
    "protobuf",
    "rtf",
    "presentation"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && cp src/propresenter.js src/propresenter.d.ts dist/",
    "prepublishOnly": "npm run build",
    "gen": "pbjs -t static-module -w esm --dts -o src/propresenter.js ./proto/presentation.proto",
    "gen:template": "tsx src/tools/generateTemplate.ts",
    "test": "tsx test/decode.ts && tsx test/encode.ts"
  },
  "dependencies": {
    "long": "^5.3.2",
    "protobufjs": "^8.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "protobufjs-cli": "^2.7.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
